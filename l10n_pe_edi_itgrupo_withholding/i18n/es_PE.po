#. module: l10n_pe_edi_itgrupo_withholding
#: model:ir.model.fields,help:l10n_pe_edi_itgrupo_withholding.field_account_retention_comp__l10n_pe_dte_status
msgid ""
"Status of sending the DTE to the SUNAT:\n"
"    - Not sent: the DTE has not been sent to SUNAT but it has created.\n"
"    - Ask For Status: The DTE is asking for its status to the SUNAT.\n"
"    - Accepted: The DTE has been accepted by SUNAT.\n"
"    - Accepted With Objections: The DTE has been accepted with objections by SUNAT.\n"
"    - Rejected: The DTE has been rejected by SUNAT.\n"
"    - Manual: The DTE is sent manually, i.e.: the DTE will not be sending manually."
msgstr ""
"Estado de envío del DTE a SUNAT:\n"
"    - No enviado: el DTE no ha sido enviado a SUNAT pero si creado.\n"
"    - Solicitar estado: El DTE está solicitando su estado a SUNAT.\n"
"    - Aceptado: El DTE ha sido aceptado por SUNAT.\n"
"    - Aceptado con observaciones: El DTE ha sido aceptado con observaciones por SUNAT.\n"
"    - Rechazado: El DTE ha sido rechazado por SUNAT.\n"
"    - Manual: El DTE es enviado manualmente, es decir: el DTE no será enviado automáticamente."

#. module: l10n_pe_edi_itgrupo_withholding
#: model:ir.model.fields,help:l10n_pe_edi_itgrupo_withholding.field_account_retention_comp__l10n_pe_dte_void_status
msgid ""
"Status of sending the Void DTE to the SUNAT:\n"
"    - Not sent: the DTE has not been sent to SUNAT but it has created.\n"
"    - Ask For Status: The DTE is asking for its status to the SUNAT.\n"
"    - Accepted: The DTE has been accepted by SUNAT.\n"
"    - Accepted With Objections: The DTE has been accepted with objections by SUNAT.\n"
"    - Rejected: The DTE has been rejected by SUNAT.\n"
"    - Manual: The DTE is sent manually, i.e.: the DTE will not be sending manually."
msgstr ""
"Estado de envío del DTE de anulación a SUNAT:\n"
"    - No enviado: el DTE no ha sido enviado a SUNAT pero si creado.\n"
"    - Solicitar estado: El DTE está solicitando su estado a SUNAT.\n"
"    - Aceptado: El DTE ha sido aceptado por SUNAT.\n"
"    - Aceptado con observaciones: El DTE ha sido aceptado con observaciones por SUNAT.\n"
"    - Rechazado: El DTE ha sido rechazado por SUNAT.\n"
"    - Manual: El DTE es enviado manualmente, es decir: el DTE no será enviado automáticamente."

