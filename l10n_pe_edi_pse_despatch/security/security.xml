<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="logistic_despatch_group_category" model="res.groups.privilege">
        <field name="name">Logistic Despatch</field>
        <field name="description">Helps to manage the logistic despatch</field>
        <field name="sequence">50</field>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="logistic_despatch_group_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="logistic_despatch_group_category"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="logisitc_despatch_company_rule" model="ir.rule">
        <field name="name">Logistic Despatch multi-company</field>
        <field name="model_id" ref="model_logistic_despatch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>