<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_logistic_despatch_form" model="ir.ui.view">
            <field name="name">logistic.despatch.form</field>
            <field name="model">logistic.despatch</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_draft" string="Draft" invisible="state != 'cancel'" type="object" />
                        <button name="action_open" string="Open" invisible="state != 'draft'" class="oe_highlight" type="object" />
                        <button name="action_cancel" string="Cancel"  invisible="state != 'open'" type="object" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,open,cancel" statusbar_colors="{&quot;to_fix&quot;:&quot;red&quot;}"/>
                    </header>
                    <div class="alert alert-info d-flex justify-content-between align-items-center" role="alert" invisible="l10n_pe_edi_status != 'not_sent' or state == 'draft'">
                         <div>The despatch will soon be sent to PSE</div>
                         <button name="l10n_pe_edi_action_send" type="object" class="oe_link py-0 text-decoration-underline" string="Process now"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'cancel' or not l10n_pe_edi_pse_uid">
                        Documento cancelado intermanete para control intero, es necesario proceder con la baja de la guia de remisión electrónica desde clave SOL
                    </div>
                    <field name="l10n_pe_edi_file" invisible="1"/>
                    <field name="l10n_pe_edi_pdf_file" invisible="1"/>
                    <field name="l10n_pe_edi_cdr_file" invisible="1"/>
                    <field name="l10n_pe_edi_status" invisible="1"/>
                    <div class="alert alert-success" role="alert" invisible="l10n_pe_edi_status != 'accepted'">
                        <strong class="alert-title">Registration in SUNAT</strong>
                        <div class="o_row"><field name="l10n_pe_edi_status_response" readonly="1" class="w-auto"/> <button name="l10n_pe_edi_action_open_xml_file" type="object" string="Open XML File" icon="fa-file-code-o" class="btn-link p-1"/>  <button name="l10n_pe_edi_action_open_pdf_file" type="object" string="Open PDF File" icon="fa-file-pdf-o" class="btn-link p-1"/> <button name="l10n_pe_edi_action_open_cdr_file" type="object" string="Open CDR File" icon="fa-file-code-o" class="btn-link p-1"/> </div>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="l10n_pe_edi_status != 'rejected'">
                        <strong class="alert-title">Registration in SUNAT</strong>
                        <div class="o_row"><field name="l10n_pe_edi_status_response" readonly="1" class="w-auto"/> <button name="l10n_pe_edi_action_open_xml_file" type="object" string="Open XML File" icon="fa-file-code-o" class="btn-link p-1"/>  <button name="l10n_pe_edi_action_open_pdf_file" type="object" string="Open PDF File" icon="fa-file-pdf-o" class="btn-link p-1"/> </div>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="l10n_pe_edi_status != 'ask_for_status'">
                        <strong class="alert-title">Registration in SUNAT</strong>
                        <div class="o_row">DTE is being processed by SUNAT <button name="l10n_pe_edi_action_open_xml_file" type="object" string="Open XML File" icon="fa-file-code-o" class="btn-link p-1"/>  <button name="l10n_pe_edi_action_open_pdf_file" type="object" string="Open PDF File" icon="fa-file-pdf-o" class="btn-link p-1"/> <button name="l10n_pe_edi_action_check" type="object" string="Get Status" icon="fa-refresh" class="btn-link p-1"/></div>
                    </div>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <h1 invisible="1">Header</h1>
                        </div>
                        <field name="id" invisible="1"/>
                        <field name="type" invisible="1"/>
                        <field name="l10n_latam_country_code" invisible="1" />
                        <field name="despatch_sent" invisible="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" class="oe_inline" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" widget="res_partner_many2one" context="{'show_address': 1, 'show_vat': True}"/>
                                <field name="l10n_pe_edi_shipment_reason" readonly="state != 'draft'"/>
                                <field name="l10n_pe_edi_transport_mode" readonly="state != 'draft'"/>
                                <field name="warehouse_id" options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
                            </group>
                            <group>
                                <field name="issue_date" readonly="state != 'draft'" />
                                <field name="start_date" readonly="state != 'draft'"/>
                                <field name="l10n_pe_edi_occurrence_date" readonly="state != 'draft'"/>
                                <field name="domain_sequence_id" invisible="1"/>
                                <field name="sequence_id" domain="[('id','in', domain_sequence_id)]" options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}" readonly="state != 'draft'"/>
                                <field name="l10n_pe_edi_invoice_number" readonly="state != 'draft'"/>
                                <field name="l10n_pe_edi_purchase_order" readonly="state != 'draft'"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group>
                            <group string="Origin">
                                <field name="l10n_pe_edi_origin_branch_code" readonly="state != 'draft'"/>
                                <field name="origin_address_id" widget="res_partner_many2one" context="{'show_address': 1, 'show_vat': True}" readonly="state != 'draft'"/>
                            </group>
                            <group string="Delivery">
                                <field name="l10n_pe_edi_delivery_branch_code" readonly="state != 'draft'"/>
                                <field name="delivery_address_id" widget="res_partner_many2one" context="{'show_address': 1, 'show_vat': True}" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="l10n_pe_edi_seller_supplier_id" readonly="state != 'draft'" />
                                <field name="l10n_pe_edi_buyer_id" readonly="state != 'draft'"/>
                                <field name="carrier_id" readonly="state != 'draft'" required="l10n_pe_edi_transport_mode == '01'"/>
                                <field name="l10n_pe_edi_mtc_authorization" readonly="state != 'draft'"/>
                                <field name="weight_uom" options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}" invisible="1" readonly="state != 'draft'"/>
                                <field name="total_weight" readonly="state != 'draft'" />
                                <field name="total_volume" readonly="state != 'draft'" />
                            </group>
                            <group>
                                <field name="driver_id" readonly="state != 'draft'" required="l10n_pe_edi_transport_mode == '02'" />
                                <field name="l10n_pe_edi_vehicle_1" required="l10n_pe_edi_transport_mode == '02'" readonly="state != 'draft'"/>
                                <field name="l10n_pe_edi_vehicle_2" readonly="state != 'draft'"/>
                                <field name="l10n_pe_edi_vehicle_3" readonly="state != 'draft'"/>
                                <field name="packages" readonly="state != 'draft'" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" context="{'default_despatch_id':id}" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="product_id" options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
                                        <field name="l10n_pe_dam_ds_code"/>
                                        <field name="name"/>
                                        <field name="uom_id" options="{'no_open': True,'no_create': 1, 'no_create_edit': 1}"/>
                                        <field name="quantity"/>
                                        <field name="weight"/>
                                        <field name="volume"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Pickings" name="pickings">
                                <field name="picking_ids"/>
                            </page>
                            <page string="Documentos relacionados" name="pe_related_documents">
                                <field name="l10n_pe_edi_reference_ids" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="partner_id"/>
                                        <field name="l10n_latam_document_type_id"/>
                                        <field name="l10n_latam_document_number"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Informacion Extra">
                                <group>
                                    <field name="l10n_pe_edi_is_vehicle_m1_l" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_is_return_with_empty_packages" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_is_empty_vehicle_return" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_is_transport_total_dam_ds" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_is_carrier_vehicle_and_driver" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_shipment_description" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_traceid_1" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_container_1" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_traceid_2" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_container_2" readonly="state != 'draft'"/>
                                    <field name="l10n_pe_edi_incoterm_id" readonly="state != 'draft'"/>
                                </group>
                            </page>
                            <page string="Electronic Despatch" name="pe_electronic_invoice" invisible="l10n_pe_edi_status == False">
                                <group>
                                    <field name="l10n_pe_edi_is_einvoice" invisible="1"/>
                                    <label for="l10n_pe_edi_status"/>
                                    <div name="l10n_pe_edi_status_container">
                                        <field name="l10n_pe_edi_status" class="oe_inline" readonly="1"/>
                                    </div>
                                    <field name="l10n_pe_edi_pse_uid"/>
                                    <field name="l10n_pe_edi_void_status" readonly="1"/>
                                    <field name="l10n_pe_edi_cancel_reason" readonly="1"/>
                                    <field name="l10n_pe_edi_partner_status" readonly="1"/>
                                    <field name="l10n_pe_edi_hash" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                        <field name="note" readonly="state != 'draft'"/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_logistic_despatch_tree" model="ir.ui.view">
            <field name="name">logistic.despatch.tree</field>
            <field name="model">logistic.despatch</field>
            <field name="arch" type="xml">
                <list>
                    <field name="internal_number"/>
                    <field name="partner_id"/>
                    <field name="issue_date"/>
                    <field name="start_date"/>
                    <field name="total_weight"/>
                    <field name="company_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
        <record id="view_logistic_despatch_search" model="ir.ui.view">
            <field name="name">logistic.despatch.search</field>
            <field name="model">logistic.despatch</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="partner_id"/>
                </search>
            </field>
        </record>

        <record id="action_logistic_despatch_tree" model="ir.actions.act_window">
            <field name="name">Despatch</field>
            <field name="res_model">logistic.despatch</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                Clic here to create a logistic despatch.
                </p>
            </field>
        </record>

        <menuitem action="action_logistic_despatch_tree" id="menu_action_logistic_despatch_tree" parent="stock.menu_stock_warehouse_mgmt" sequence="20"/>
    </data>
</odoo>
