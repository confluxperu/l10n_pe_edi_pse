<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='alerts']" position="after">
                    <field name="l10n_pe_edi_xml_file" invisible="1"/>
                    <field name="l10n_pe_edi_pdf_file" invisible="1"/>
                    <field name="l10n_pe_edi_cdr_file" invisible="1"/>
                    <field name="l10n_pe_edi_pse_status" invisible="1"/>
                    <div class="alert alert-success" role="alert" invisible="l10n_pe_edi_pse_status != 'accepted'">
                        <strong class="alert-title">Registration in SUNAT</strong>
                        <div class="o_row"><field name="l10n_pe_edi_pse_status_response" readonly="1" class="w-auto"/> <button name="l10n_pe_edi_pse_action_open_xml_file" type="object" string="Open XML File" icon="fa-file-code-o" class="btn-link p-1"/>  <button name="l10n_pe_edi_pse_action_open_pdf_file" type="object" string="Open PDF File" icon="fa-file-pdf-o" class="btn-link p-1"/> <button name="l10n_pe_edi_pse_action_open_cdr_file" type="object" string="Open CDR File" icon="fa-file-code-o" class="btn-link p-1"/> </div>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="l10n_pe_edi_pse_status != 'rejected'">
                        <strong class="alert-title">Registration in SUNAT</strong>
                        <div class="o_row"><field name="l10n_pe_edi_pse_status_response" readonly="1" class="w-auto"/> <button name="l10n_pe_edi_pse_action_open_xml_file" type="object" string="Open XML File" icon="fa-file-code-o" class="btn-link p-1"/>  <button name="l10n_pe_edi_pse_action_open_pdf_file" type="object" string="Open PDF File" icon="fa-file-pdf-o" class="btn-link p-1"/> </div>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="l10n_pe_edi_pse_status != 'ask_for_status'">
                        <strong class="alert-title">Registration in SUNAT</strong>
                        <div class="o_row">DTE is being processed by SUNAT <button name="l10n_pe_edi_pse_action_open_xml_file" type="object" string="Open XML File" icon="fa-file-code-o" class="btn-link p-1"/>  <button name="l10n_pe_edi_pse_action_open_pdf_file" type="object" string="Open PDF File" icon="fa-file-pdf-o" class="btn-link p-1"/> <button name="action_l10n_pe_edi_pse_status" type="object" string="Get Status" icon="fa-refresh" class="btn-link p-1"/></div>
                    </div>
                </xpath>

                <xpath expr="//div[@id='alerts']" position="after">
                    <field name="l10n_pe_edi_pse_void_status" invisible="1"/>
                    <field name="l10n_pe_edi_void_xml_file" invisible="1"/>
                    <field name="l10n_pe_edi_void_pdf_file" invisible="1"/>
                    <field name="l10n_pe_edi_void_cdr_file" invisible="1"/>
                    <div class="alert alert-success" role="alert" invisible="l10n_pe_edi_pse_void_status != 'accepted'">
                        <strong class="alert-title">Cancellation in SUNAT</strong>
                        <div class="o_row"><field name="l10n_pe_edi_pse_void_status_response" readonly="1" class="w-auto"/> <button name="l10n_pe_edi_pse_action_open_void_xml_file" type="object" string="Open XML File" icon="fa-file-code-o" class="btn-link p-1"/>  <button name="l10n_pe_edi_pse_action_open_void_pdf_file" type="object" string="Open PDF File" icon="fa-file-pdf-o" class="btn-link p-1"/> <button name="l10n_pe_edi_pse_action_open_void_cdr_file" type="object" string="Open CDR File" icon="fa-file-code-o" class="btn-link p-1"/> </div>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="l10n_pe_edi_pse_void_status != 'rejected'">
                        <strong class="alert-title">Cancellation in SUNAT</strong>
                        <div class="o_row"><field name="l10n_pe_edi_pse_void_status_response" readonly="1" class="w-auto"/> <button name="l10n_pe_edi_pse_action_open_void_xml_file" type="object" string="Open XML File" icon="fa-file-code-o" class="btn-link p-1"/>  <button name="l10n_pe_edi_pse_action_open_void_pdf_file" type="object" string="Open PDF File" icon="fa-file-pdf-o" class="btn-link p-1"/> <button name="action_l10n_pe_edi_pse_void_status" type="object" string="Get Status" icon="fa-refresh" class="btn-link p-1"/> </div>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="l10n_pe_edi_pse_void_status != 'ask_for_status'">
                        <strong class="alert-title">Cancellation in SUNAT</strong>
                        <div class="o_row">Cancellation is being processed by SUNAT <button name="l10n_pe_edi_pse_action_open_void_xml_file" type="object" string="Open XML File" icon="fa-file-code-o" class="btn-link p-1" invisible="not l10n_pe_edi_void_xml_file"/>  <button name="l10n_pe_edi_pse_action_open_void_pdf_file" type="object" string="Open PDF File" icon="fa-file-pdf-o" class="btn-link p-1" invisible="not l10n_pe_edi_void_pdf_file"/> <button name="action_l10n_pe_edi_pse_void_status" type="object" string="Get Status" icon="fa-refresh" class="btn-link p-1"/></div>
                    </div>
                </xpath>
                
                <xpath expr="//button[@name='button_cancel_posted_moves']" position="attributes">
                    <attribute name="invisible">not l10n_pe_edi_show_cancel_button</attribute>
                </xpath>
                <xpath expr="//button[@name='button_draft']" position="attributes">
                    <attribute name="invisible">state != 'posted' or not l10n_pe_edi_show_reset_to_draft_button or need_cancel_request</attribute>
                </xpath>
                <xpath expr="//field[@name='l10n_pe_edi_charge_reason']" position="after">
                    <field name="l10n_pe_edi_rectification_ref_type" readonly= "state != 'draft'" />
                    <field name="l10n_pe_edi_rectification_ref_number" readonly= "state != 'draft'" />
                    <field name="l10n_pe_edi_rectification_ref_date" readonly= "state != 'draft'" />
                </xpath>

                <xpath expr="//field[@name='l10n_pe_edi_charge_reason']" position="attributes">
                    <attribute name="invisible">move_type != 'out_invoice'</attribute>
                    <attribute name="readonly">state != 'draft'</attribute>
                </xpath>

                <field name="l10n_pe_edi_refund_reason" position="attributes">
                    <attribute name="invisible">move_type != 'out_refund'</attribute>
                    <attribute name="readonly">state != 'draft'</attribute>
                </field>

                <xpath expr="//page[@name='l10n_pe_edi']" position="inside">
                    <group string="Credit Installments" name="payment_fee_group">
                        <field name="l10n_pe_edi_payment_fee_ids" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="amount_total" sum="Total"/>
                                <field name="date_due"/>
                                <field name="currency_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="Transport Documents" name="transport_group">
                        <field name="l10n_pe_edi_transportref_ids" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="ref_type"/>
                                <field name="ref_number"/>
                            </list>
                        </field>
                    </group>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="after">
                    <button name="show_detail_downpayment" string="+" type="object" invisible="not id" icon="fa-external-link" width="0.1"/>
                </xpath>
            </field>
        </record>
        <record id="detail_downpayment" model="ir.ui.view">
            <field name="model">account.move.line</field>
            <field name="name">form_l10n_pe_edi.downpayment</field>
            <field name="arch" type="xml">
                 <form string="Integrity Sale">
                     <sheet>
                         <group>
                            <field name="name" readonly="1" />
                            <field name="l10n_pe_edi_downpayment_line"/>
                            <field name="l10n_pe_edi_downpayment_invoice_id" readonly="not l10n_pe_edi_downpayment_line" />
                            <field name="l10n_pe_edi_downpayment_ref_type" readonly="not l10n_pe_edi_downpayment_line" />
                            <field name="l10n_pe_edi_downpayment_ref_number" readonly="not l10n_pe_edi_downpayment_line" />
                            <field name="l10n_pe_edi_downpayment_date" readonly="not l10n_pe_edi_downpayment_line" />
                         </group>
                     </sheet>
                 </form>
            </field>
        </record>
    </data>
</odoo>